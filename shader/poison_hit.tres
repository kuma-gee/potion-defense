code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, depth_test_default, cull_back, diffuse_lambert, specular_schlick_ggx, unshaded;

uniform vec4 Circle_Color : source_color;
uniform vec2 Noise_Speed = vec2(0.000000, 0.000000);
uniform sampler2D Noise;
uniform float Extra_Opacity : hint_range(0.0, 1.0);
uniform vec2 UV_Scale = vec2(1.000000, 1.000000);
uniform sampler2D Texture_Lineal : source_color, repeat_disable;
uniform sampler2D tex_frg_10;
uniform float Alpha : hint_range(0.0, 1.0) = 1.0;



void fragment() {
// ColorParameter:7
	vec4 n_out7p0 = Circle_Color;


// Input:17
	vec4 n_out17p0 = COLOR;
	float n_out17p4 = n_out17p0.a;


// Input:24
	float n_out24p0 = TIME;


// Vector2Parameter:26
	vec2 n_out26p0 = Noise_Speed;


// FloatOp:25
	float n_out25p0 = n_out24p0 * n_out26p0.x;


// UVFunc:22
	vec2 n_in22p1 = vec2(1.00000, 1.00000);
	vec2 n_out22p0 = vec2(n_out25p0) * n_in22p1 + UV;


	vec4 n_out21p0;
// Texture2D:21
	n_out21p0 = texture(Noise, n_out22p0);


// FloatOp:23
	float n_out23p0 = n_out17p4 * n_out21p0.x;


// FloatParameter:8
	float n_out8p0 = Extra_Opacity;


// Vector2Parameter:19
	vec2 n_out19p0 = UV_Scale;


// Input:14
	vec4 n_out14p0 = COLOR;
	float n_out14p1 = n_out14p0.r;


	float n_out15p0;
// Remap:15
	float n_in15p1 = 0.00000;
	float n_in15p2 = 1.00000;
	float n_in15p3 = 0.80000;
	float n_in15p4 = -0.40000;
	{
		float __input_range = n_in15p2 - n_in15p1;
		float __output_range = n_in15p4 - n_in15p3;
		n_out15p0 = n_in15p3 + __output_range * ((n_out14p1 - n_in15p1) / __input_range);
	}


// VectorCompose:16
	float n_in16p0 = 0.00000;
	vec2 n_out16p0 = vec2(n_in16p0, n_out15p0);


// UVFunc:3
	vec2 n_out3p0 = n_out16p0 * n_out19p0 + UV;


	vec4 n_out13p0;
// Texture2D:13
	n_out13p0 = texture(Texture_Lineal, n_out3p0);
	float n_out13p1 = n_out13p0.r;


// FloatOp:9
	float n_out9p0 = n_out8p0 + n_out13p1;


// Texture2D:10
	vec4 n_out10p0 = texture(tex_frg_10, UV);


// FloatOp:11
	float n_out11p0 = n_out9p0 * n_out10p0.x;


// FloatOp:18
	float n_out18p0 = n_out23p0 * n_out11p0;


// FloatParameter:28
	float n_out28p0 = Alpha;


// FloatOp:27
	float n_out27p0 = n_out18p0 * n_out28p0;


// Output:0
	ALBEDO = vec3(n_out7p0.xyz);
	ALPHA = n_out27p0;


}
